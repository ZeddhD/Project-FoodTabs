# ============================================================
# FoodTabs — Server Environment Variables
# Copy this file to server/.env and fill in your values.
# NEVER commit server/.env to git.
# ============================================================

# ---- Database ----
# Local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/foodtabs

# ---- Authentication ----
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Frontend URL (for CORS in production) ----
CLIENT_URL=http://localhost:5173

# ---- Stripe (Test Mode) ----
# Get keys from https://dashboard.stripe.com/test/keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ---- File Uploads ----
# Max upload size in bytes (default 5 MB)
MAX_FILE_SIZE=5242880
